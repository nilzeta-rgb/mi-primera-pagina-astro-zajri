        <!-- Para Texto en movimiento -->
        <style>
            @keyframes moverTexto {
                from {
                    transform: translateX(0%);
                }
                to {
                    transform: translateX(-100%);
                }
            }
        <style>

            /* =====================================================
            CONFIGURACIÓN DE LOS BOTONES
            ===================================================== */
            .boton-zajri {

                /* COLOR DEL FONDO NORMAL */
                background-color: #050505;

                /* COLOR DE LAS LETRAS NORMAL */
                color: #FFFFFF;

                /* COLOR DEL BORDE */
                border: 2px solid #050505;

                /* TAMAÑO DEL BOTÓN */
                padding: 12px 30px;

                /* TAMAÑO DE LAS LETRAS */
                font-size: 16px;

                /* TIPO DE LETRA */
                font-family: Arial, sans-serif;

                /* LETRA EN NEGRITA */
                font-weight: bold;

                /* REDONDEADO DE LAS ESQUINAS */
                border-radius: 5px;

                /* FORMA DEL CURSOR */
                cursor: pointer;

                /* ESPACIO ENTRE BOTONES */
                margin-right: 5px;

                /* CAMBIO DE COLOR SUAVE */
                transition: background-color 0.3s ease,
                            color 0.3s ease,
                            border-color 0.3s ease;
            }

            /* =====================================================
            CUANDO EL MOUSE SE ACERCA
            ===================================================== */

            .boton-zajri:hover {

                /* COLOR DEL BOTÓN AL ACERCAR EL MOUSE */
                background-color: #808080;

                /* COLOR DE LAS LETRAS AL ACERCAR EL MOUSE */
                color: #FFFFFF;

                /* COLOR DEL BORDE */
                border-color: #808080;
            }

        </style>
        
        <style>
            /* =====================================================
            CONFIGURACIÓN GENERAL DE LOS BOTONES
            ===================================================== */

            .boton-menu {
                background-color: #050505;   /* Fondo negro */
                color: #ffffff;              /* Letras blancas */
                border: none;
                padding: 12px 30px;

                /* TAMAÑO DE LAS LETRAS */
                font-size: 16px;

                border-radius: 5px;
                cursor: pointer;
                font-weight: bold;

                /* TRANSICIÓN DEL EFECTO */
                transition: all 0.3s ease;

                /* PERMITE MOVER EL BOTÓN */
                position: relative;
            }

            /* =====================================================
            EFECTO CUANDO EL MOUSE PASA SOBRE EL BOTÓN
            ===================================================== */

            .boton-menu:hover {
                background-color: #808080;   /* Cambia a gris */
                color: #ffffff;              /* Mantiene letras blancas */

                transform: translateY(-3px);

                box-shadow: 0 5px 12px rgba(0, 0, 0, 0.35);
            }

            /* =====================================================
            EFECTO CUANDO SE HACE CLIC
            ===================================================== */

            .boton-menu:active {
                transform: translateY(0px);
                box-shadow: 0 2px 5px rgba(0, 0, 0, 0.30);
            }

            /* =====================================================
            POSICIÓN INDIVIDUAL DE CADA BOTÓN
            ===================================================== */

            /* Botón 1 - Quienes somos */
            .boton-1 {
                left: 10px;       /* + derecha / - izquierda */
